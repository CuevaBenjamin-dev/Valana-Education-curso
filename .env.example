# URL pública definitiva, incluyendo https://. Dejar vacío durante el desarrollo inicial.
PUBLIC_SITE_URL=

# WhatsApp: código de país y número, entre 8 y 15 cifras. No incluir prefijo 00.
# Admite + inicial, espacios y guiones. Vacío conserva los CTA sin enlace real.
PUBLIC_WHATSAPP_NUMBER=

# Opcionales. Los proveedores solo se cargan después de aceptar el consentimiento.
PUBLIC_CLARITY_PROJECT_ID=
PUBLIC_META_PIXEL_ID=
