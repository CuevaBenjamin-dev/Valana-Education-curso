---
import { courseInfo } from '../data/course';
import SectionLabel from './SectionLabel.astro';
---
<section id="informacion" class="section section--paper course-info" data-analytics-section="course_info" aria-labelledby="info-title"><div class="container"><SectionLabel number="06" text="ORGANIZA TU SIGUIENTE PASO"/><div class="info-grid"><div data-reveal><h2 id="info-title" class="display section-title">EL CURSO,<br/>EN DETALLE.</h2><p>Estamos preparando los detalles.<br/>Aquí encontrarás la información de la próxima edición.</p><span class="info-status eyebrow"><i></i> INFORMACIÓN EN PREPARACIÓN</span></div><dl class="info-list" data-reveal>{courseInfo.map(item => <div><dt>{item.label}</dt><dd class:list={{ pending:item.pending }}>{item.pending ? `[ ${item.value.toUpperCase()} ]` : item.value}</dd></div>)}</dl></div></div></section>
<style>
  .info-grid { display:grid; grid-template-columns:1fr 1.1fr; gap:10%; }.info-grid>div>p { margin-top:1.8rem; font-size:12px; line-height:1.9; color:var(--color-muted); }.info-status { display:flex; gap:.6rem; align-items:center; margin-top:2rem; color:var(--color-muted); font-size:7px; }.info-status i { width:5px; height:5px; border-radius:50%; background:#71855e; }.info-list { margin:0; border-top:1px solid var(--color-line); }.info-list>div { display:grid; grid-template-columns:1fr 1.3fr; gap:1rem; padding:1rem 0; border-bottom:1px solid var(--color-line); font-size:12px; }.info-list dt { color:var(--color-muted); }.info-list dd { margin:0; }.info-list .pending { font-size:9px; letter-spacing:.035em; padding-top:3px; color:#65705a; }
  @media(max-width:699px) { .info-grid { grid-template-columns:1fr; gap:2.2rem; }.info-grid>div>p { margin-top:1.2rem; }.info-status { margin-top:1.3rem; }.info-list>div { font-size:11px; } }
</style>
