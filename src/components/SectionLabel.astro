---
interface Props { number: string; text: string; }
const { number, text } = Astro.props;
---
<div class="section-label eyebrow"><span>[ {number} ]</span><span>{text}</span></div>
<style>.section-label { display:flex; align-items:center; gap:1.25rem; margin-bottom:2.5rem; }.section-label span:first-child { color:var(--color-muted); font-variant-numeric:tabular-nums; }</style>
