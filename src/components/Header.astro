---
import CTAButton from './CTAButton.astro';
const links = [{ label: 'El curso', href: '/#curso' }, { label: 'Contenido', href: '/#contenido' }, { label: 'Docente', href: '/#docente' }, { label: 'FAQ', href: '/#faq' }];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="ESCS — inicio"><span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span>ESCS<span class="brand-note">EDUCACIÓN<br/>QUE TRANSFORMA.</span></a>
    <nav class="desktop-nav" aria-label="Navegación principal">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <div class="header-actions"><CTAButton location="header" compact /><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></div>
  </div>
  <nav id="mobile-nav" class="mobile-nav container" aria-label="Navegación móvil" hidden>{links.map((link, index) => <a href={link.href}><span class="eyebrow">0{index + 1}</span>{link.label}<span aria-hidden="true">↗</span></a>)}</nav>
</header>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#mobile-nav');
  function closeMenu() { if (menu && nav) { menu.setAttribute('aria-expanded', 'false'); menu.setAttribute('aria-label', 'Abrir menú'); nav.hidden = true; } }
  menu?.addEventListener('click', () => { if (!nav) return; const expanded = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded', String(!expanded)); menu.setAttribute('aria-label', expanded ? 'Abrir menú' : 'Cerrar menú'); nav.hidden = expanded; });
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
  matchMedia('(min-width: 900px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
</script>
<style>
  .site-header { position:sticky; top:0; z-index:30; background:rgb(32 34 31 / 97%); border-bottom:1px solid var(--color-line); }
  .header-inner { display:flex; align-items:center; justify-content:space-between; gap:1rem; min-height:86px; }
  .brand { display:flex; align-items:center; gap:.6rem; font-size:30px; font-weight:800; letter-spacing:-.075em; line-height:1; }
  .brand-symbol { display:grid; gap:3px; width:16px; }.brand-symbol i { height:3px; background:var(--color-accent); }.brand-symbol i:nth-child(2) { width:11px; }
  .brand-note { margin-left:1rem; padding-left:1rem; border-left:1px solid var(--color-line); font-size:7px; font-weight:500; line-height:1.65; letter-spacing:.09em; }
  .desktop-nav { display:flex; align-items:center; gap:2rem; }.desktop-nav a { display:flex; align-items:center; min-height:44px; color:var(--color-muted); font-size:11px; transition:color .2s; }.desktop-nav a:hover { color:var(--color-accent); }
  .header-actions { display:flex; align-items:center; gap:1rem; }.menu-toggle { display:none; width:44px; height:44px; border:1px solid var(--color-line); background:none; padding:12px; }.menu-toggle span { display:block; height:1px; background:var(--color-text); margin:5px 0; transition:transform .2s; }.menu-toggle[aria-expanded='true'] span:first-child { transform:translateY(3px) rotate(45deg); }.menu-toggle[aria-expanded='true'] span:last-child { transform:translateY(-3px) rotate(-45deg); }
  .mobile-nav { padding-block:1rem 2rem; }.mobile-nav a { display:flex; align-items:center; gap:1.5rem; min-height:56px; border-top:1px solid var(--color-line); font-size:16px; }.mobile-nav a span:last-child { margin-left:auto; }.mobile-nav .eyebrow { color:var(--color-muted); }
  @media(max-width:899px) { .desktop-nav,.brand-note { display:none; }.menu-toggle { display:block; }.header-inner { min-height:76px; }.brand { font-size:28px; } }
  @media(max-width:430px) { .header-actions { gap:.6rem; }.header-actions :global(.cta--compact) { gap:.65rem; font-size:8px; padding:.65rem .7rem; }.header-actions :global(.cta svg) { width:16px; } }
</style>
