---
import { sessions } from '../data/course';
import SectionLabel from './SectionLabel.astro';
import CTAButton from './CTAButton.astro';
---
<section id="contenido" class="section section--paper curriculum" data-analytics-section="curriculum" aria-labelledby="curriculum-title">
  <div class="container"><SectionLabel number="03" text="EL RECORRIDO"/>
    <div class="curriculum-heading" data-reveal><h2 id="curriculum-title" class="display section-title">DE ENTENDER LA IA<br/>A <span>USARLA DE VERDAD.</span></h2><div><span class="session-count display">04<span>SESIONES</span></span><span class="eyebrow proposal">PROGRAMA PROPUESTO</span></div></div>
    <div class="session-list">{sessions.map((session, index) => <details class="session" open={index === 0} data-accordion data-reveal><summary aria-expanded={index === 0}><span class="session-number display">{session.number}</span><h3 class="display">{session.title}</h3><span class="session-duration eyebrow">DURACIÓN: {session.duration}</span><span class="session-toggle" aria-hidden="true"></span></summary><div class="session-body"><p>{session.description}</p>{session.topics?.length > 0 && <ul>{session.topics.map(topic => <li>{topic}</li>)}</ul>}<span class="mobile-duration eyebrow">DURACIÓN: {session.duration}</span></div></details>)}</div>
    <div class="curriculum-bottom"><p>Un recorrido paso a paso.<br/><strong>Con el trabajo real como punto de partida.</strong></p><CTAButton location="curriculum" label="Quiero conocer más" variant="outline"/></div>
  </div>
</section>
<style>
  .curriculum-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:2rem; margin-bottom:3rem; }.section-title { font-size:clamp(3.1rem,5.7vw,5.5rem); }.section-title span { color:#747a6d; }.session-count { display:flex; align-items:baseline; gap:.7rem; font-size:80px; line-height:.85; }.session-count>span { font-size:20px; }.proposal { display:block; margin-top:1rem; font-size:7px; color:var(--color-muted); }
  .session-list { border-top:1px solid var(--color-line); }.session { border-bottom:1px solid var(--color-line); }.session summary { display:grid; grid-template-columns:80px 1fr 170px 28px; align-items:center; gap:1.5rem; min-height:110px; padding-block:1.4rem; }.session-number { color:#747a6d; font-size:36px; }.session h3 { font-size:clamp(1.7rem,3.1vw,2.7rem); font-weight:500; }.session-duration { font-size:8px; color:var(--color-muted); }.session-toggle { width:26px; height:26px; position:relative; }.session-toggle::before,.session-toggle::after { content:''; position:absolute; top:12px; left:3px; width:20px; height:1px; background:currentColor; transition:transform .2s; }.session-toggle::after { transform:rotate(90deg); }.session[open] .session-toggle::after { transform:rotate(0); }.session[open] .session-number { color:#4d6640; }.session-body { display:grid; grid-template-columns:1fr 1fr; gap:2rem; padding:0 3rem 2rem calc(80px + 1.5rem); color:var(--color-muted); font-size:12px; }.session-body>p { max-width:360px; }.session-body ul { display:grid; gap:.4rem; }.session-body li { display:flex; align-items:baseline; gap:.7rem; }.session-body li::before { content:'↗'; font-size:11px; color:#596b46; }.mobile-duration { display:none; }.curriculum-bottom { display:flex; justify-content:space-between; gap:1.5rem; align-items:center; margin-top:2rem; }.curriculum-bottom p { font-size:12px; color:var(--color-muted); }.curriculum-bottom strong { color:var(--color-ink); font-weight:500; }
  @media(max-width:799px) { .session summary { grid-template-columns:50px 1fr 24px; gap:1rem; }.session-duration { display:none; }.session-body { padding-left:66px; padding-right:1rem; }.mobile-duration { display:block; grid-column:1/-1; font-size:8px; }.curriculum-heading { align-items:flex-start; }.session-count { font-size:58px; flex-direction:column; gap:.5rem; }.session-count>span { font-size:17px; }.proposal { max-width:70px; line-height:1.7; font-size:6px; } }
  @media(max-width:599px) { .curriculum-heading { gap:1rem; }.section-title { font-size:clamp(2.8rem,10.6vw,4.7rem); }.session-count { font-size:42px; }.session-count>span { font-size:14px; }.session summary { grid-template-columns:32px 1fr 20px; gap:.8rem; min-height:100px; }.session h3 { font-size:26px; }.session-number { font-size:27px; }.session-body { grid-template-columns:1fr; gap:1rem; padding-left:45px; font-size:11px; }.session-toggle { width:20px; }.session-toggle::before,.session-toggle::after { width:16px; }.curriculum-bottom { flex-direction:column; align-items:flex-start; gap:1.5rem; } }
</style>
