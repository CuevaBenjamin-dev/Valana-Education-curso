---
import { instructor } from '../data/course';
import SectionLabel from './SectionLabel.astro';
import InstructorPortrait from './InstructorPortrait.astro';
import CTAButton from './CTAButton.astro';
---
<section id="docente" class="section instructor" data-analytics-section="instructor" aria-labelledby="instructor-title">
  <div class="container"><SectionLabel number="05" text="QUIÉN TE VA A ENSEÑAR"/>
    <div class="instructor-grid"><div class="instructor-visual" data-reveal><InstructorPortrait variant="instructor"/></div><div class="instructor-copy" data-reveal><span class="eyebrow instructor-kicker">TECNOLOGÍA REAL. UNA PERSONA REAL.</span><h2 id="instructor-title" class="display section-title">{instructor.name.split(' ')[0]}<br/>{instructor.name.split(' ').slice(1).join(' ')}<span>.</span></h2><p class="instructor-role">{instructor.role}</p><p class="instructor-bio">{instructor.bio}</p><ul class="instructor-tags" aria-label="Áreas de trabajo"><li>IA</li><li>AUTOMATIZACIÓN</li><li>SOFTWARE</li><li>DIGITALIZACIÓN</li></ul><CTAButton location="instructor" label="Conversemos sobre el curso" variant="outline"/></div></div>
  </div>
</section>
<style>
  .instructor-grid { display:grid; grid-template-columns:1fr 1.15fr; gap:9%; }.instructor-copy { padding-block:1rem; }.instructor-kicker { font-size:8px; color:var(--color-secondary-accent); }.section-title { margin-top:1.6rem; font-size:clamp(4.5rem,8vw,7.5rem); }.section-title>span { color:var(--color-accent); }.instructor-role { margin-top:1.5rem; max-width:340px; font-size:14px; line-height:1.8; }.instructor-bio { margin-top:1.3rem; color:var(--color-muted); font-size:12px; max-width:430px; line-height:1.9; }.instructor-tags { display:flex; flex-wrap:wrap; gap:.5rem; margin-block:1.8rem 2rem; }.instructor-tags li { border:1px solid var(--color-line); padding:.4rem .6rem; font-size:7px; letter-spacing:.055em; color:var(--color-muted); }
  @media(max-width:699px) { .instructor-grid { grid-template-columns:1fr; gap:2rem; }.instructor-visual { order:2; }.instructor-copy { padding:0; }.section-title { font-size:clamp(5rem,20vw,7rem); margin-top:1.2rem; }.instructor-role { font-size:14px; }.instructor-bio { max-width:unset; font-size:12px; } }
</style>

