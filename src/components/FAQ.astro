---
import { faq } from '../data/course';
import SectionLabel from './SectionLabel.astro';
---
<section id="faq" class="section faq" data-analytics-section="faq" aria-labelledby="faq-title"><div class="container"><SectionLabel number="07" text="ANTES DE EMPEZAR"/><div class="faq-grid"><div data-reveal><h2 id="faq-title" class="display section-title">BUENAS<br/>PREGUNTAS.</h2><p>Empezar algo nuevo trae dudas.<br/>Resolvamos las primeras.</p></div><div class="faq-list">{faq.map((item, index) => <details data-faq-id={item.id} data-accordion data-reveal><summary aria-expanded="false" aria-controls={`answer-${item.id}`}><span class="eyebrow">0{index + 1}</span><h3>{item.question}</h3><span class="faq-plus" aria-hidden="true">+</span></summary><div id={`answer-${item.id}`} class="faq-answer"><p>{item.answer}</p></div></details>)}</div></div></div></section>
<style>
  .faq-grid { display:grid; grid-template-columns:1fr 1.55fr; gap:10%; }.faq-grid>div>p { margin-top:1.5rem; color:var(--color-muted); font-size:12px; line-height:1.9; }.faq-list { border-top:1px solid var(--color-line); }.faq-list details { border-bottom:1px solid var(--color-line); }.faq-list summary { display:grid; grid-template-columns:18px 1fr 20px; align-items:center; gap:1.1rem; min-height:82px; padding-block:1.2rem; }.faq-list summary>.eyebrow { font-size:8px; color:var(--color-muted); }.faq-list h3 { font-size:13px; font-weight:500; line-height:1.6; }.faq-plus { color:var(--color-accent); font-size:24px; font-weight:400; text-align:center; transition:transform .2s; }.faq-list details[open] .faq-plus { transform:rotate(45deg); }.faq-answer { padding:0 2rem 1.5rem calc(18px + 1.1rem); color:var(--color-muted); font-size:12px; line-height:1.9; }
  @media(max-width:699px) { .faq-grid { grid-template-columns:1fr; gap:2rem; }.faq-list summary { min-height:82px; gap:.8rem; }.faq-list h3 { font-size:12px; }.faq-answer { padding-left:31px; padding-right:1rem; font-size:11px; } }
</style>
